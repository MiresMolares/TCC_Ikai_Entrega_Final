# Copie para .env e preencha. O .env NUNCA vai para o GitHub.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ikai
# Qualquer texto longo e aleatório (pelo menos 16 caracteres):
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Em produção, o endereço do site/app. Vários separados por vírgula.
CORS_ORIGEM=*
